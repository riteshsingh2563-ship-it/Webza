# ==============================================================================
# WEBZA — DIGITAL EXPERIENCE STUDIO
# Environment Configuration (.env.local)
# ==============================================================================
# For Vercel Deployment:
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. Enable Firestore Database in Native mode.
# 3. Enable Firebase Storage.
# 4. Copy your Web App config credentials into these variables in Vercel.
# 
# NOTE: If these variables are not provided, WEBZA automatically activates
# high-performance Local Reactive Mode with localStorage persistence,
# ensuring zero broken builds or runtime crashes out-of-the-box!
# ==============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=webza-agency.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=webza-agency
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=webza-agency.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=102938475610
NEXT_PUBLIC_FIREBASE_APP_ID=1:102938475610:web:abcdef1234567890

# Admin Master Access Key (Used for quick admin console sign-in)
NEXT_PUBLIC_ADMIN_MASTER_KEY=WEBZA-2026-ADMIN

# Resend Email Integration
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_EMAIL=webzaa.in@gmail.com

# Production Site URL
NEXT_PUBLIC_SITE_URL=https://webza.agency
